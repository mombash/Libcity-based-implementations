{
    "d_model": 96,
    "d_state": 32,
    "d_conv": 4,
    "expand": 2,
    "max_epoch": 300,
    "batch_size": 16,
    "learner": "adam",
    "learning_rate": 0.001,
    "lr_decay": true,
    "lr_scheduler": "cosineannealinglr",
    "input_window": 12,
    "output_window": 12,
    "executor": "TrafficStateExecutor",
    "early_stop": true,
    "patience": 15,
    "weight_decay": 0.0001,
    "input_embedding_dim": 24,
    "temporal_emb_dim": 24,
    "spatial_embedding_dim": 16,
    "adaptive_embedding_dim": 80,
    "add_time_in_day": true,
    "add_day_in_week": true,
    "steps_per_day": 288,
    "dropout": 0.1,
    "apply_zscore_normalization": true,
    "temporal_mode": "direct",
    "temporal_projection_dim": 24,
    "lstm_hidden_size": 96,
    "lstm_num_layers": 2,
    "noMamba": false,
    "noSpatial": false,
    "noTemporal": false,
    "noMTemporal": false,
    "noLSTM": false,
    "noEmbeddings": false,
    "noEmbSpatial": false,
    "noEmbTemporal": false,
    "noEmbAdaptive": false,
    "use_sliding_window": true
}
